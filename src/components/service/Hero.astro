---
/**
 * /service – Sektion 0 „Hero“ (ehem. Onepage-Vibe-Sektion, statisch ohne JS).
 * Hintergrundfoto als echtes <img> (WebP, srcset, priority) statt CSS-Background – gleiche Optik.
 */
import { Image } from 'astro:assets';
import { imageMeta } from '../../data/images';
import { hero } from './content';
---

<section class="section">
  <Image
    src={imageMeta('support-mitarbeiter-mehrere-monitore')}
    alt=""
    class="bg"
    widths={[640, 960, 1280, 1600, 1920, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    format="webp"
  />
  <div class="overlay"></div>
  <div class="orangeBar"></div>
  <div class="container">
    <div class="intro">
      <h1 class="headline">
        {hero.headline}<br />
        <span class="accent">{hero.headlineAccent}</span>
      </h1>
      <p class="subline">{hero.subline}</p>
      <ul class="trustRow">
        {hero.trust.map((t) => (
          <li class="trustItem">
            <span class="dot" aria-hidden="true"></span>
            <span>{t}</span>
          </li>
        ))}
      </ul>
      <a href={hero.ctaHref} class="cta">{hero.ctaLabel} &rarr;</a>
    </div>
  </div>
  <div class="orangeBarBottom"></div>
</section>

<style>
  .section {
    background: var(--color-kit-dark);
    position: relative;
    padding: 0;
    isolation: isolate;
  }
  /* ersetzt background-size:cover; background-position:center */
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -1;
  }
  .orangeBar {
    height: 6px;
    background: var(--color-kit-key1);
    width: 100%;
  }
  .overlay {
    position: absolute;
    inset: 0;
    background: #00000088;
    z-index: 0;
  }
  .container {
    position: relative;
    z-index: 1;
    max-width: 1250px;
    margin: 0 auto;
    padding: 48px 24px 0;
  }
  .orangeBarBottom {
    height: 3px;
    background: var(--color-kit-key1);
    width: 100%;
    margin-top: 32px;
  }
  /* framer-motion: initial {opacity:0,y:28} → 0.55s easeOut beim Laden */
  .intro {
    animation: svc-hero-in 0.55s ease-out both;
  }
  @keyframes svc-hero-in {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: none; }
  }
  .headline {
    font-family: var(--font-kit-header-font);
    font-size: clamp(36px, 6.5vw, 64px);
    font-weight: 900;
    line-height: 1.06;
    letter-spacing: -1.5px;
    color: #fff;
    margin-bottom: 18px;
  }
  .accent {
    color: var(--color-kit-key1);
  }
  .subline {
    font-family: var(--font-kit-text-font);
    font-size: clamp(17px, 2.2vw, 21px);
    color: #eee;
    font-weight: 300;
    line-height: 1.65;
    max-width: 600px;
    margin-bottom: 24px;
  }
  .trustRow {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
  }
  .trustItem {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-kit-text-font);
    font-size: 14px;
    color: #ccc;
    font-weight: 300;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3ecf8e;
    flex-shrink: 0;
  }
  .cta {
    display: inline-block;
    background: var(--color-kit-key1);
    color: #fff;
    font-family: var(--font-kit-text-font);
    font-size: 17px;
    font-weight: 700;
    padding: 18px 36px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: opacity 0.2s;
  }
  .cta:hover {
    opacity: 0.88;
  }
  @media (max-width: 480px) {
    .container {
      padding: 36px 20px 0;
    }
    .cta {
      width: 100%;
      text-align: center;
      padding: 20px 20px;
    }
  }
</style>
