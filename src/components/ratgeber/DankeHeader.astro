---
/**
 * Kopf der Dankeseiten (Onepage „Header“, header-v2, nur Logo 75 %).
 * Gemessen: weiß, 73 px hoch, Logo 188 × 41 px – Desktop zentriert, mobil (≤ 767 px) linksbündig.
 */
import { Image } from 'astro:assets';
import { imageMeta } from '../../data/images';
import { site } from '../../data/site';
---

<header class="rg-dhead">
  <a class="rg-dhead__link" href="/" aria-label={`${site.name} – Startseite`}>
    <Image
      src={imageMeta('logo-blaschke-it')}
      alt={site.name}
      width={188}
      height={41}
      widths={[188, 376]}
      sizes="188px"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
  </a>
</header>

<style>
  .rg-dhead {
    display: flex;
    justify-content: center;
    padding: 16px 24px;
    background: #fff;
  }
  .rg-dhead__link { display: block; line-height: 0; }
  .rg-dhead :global(img) { width: 188px; height: 41px; object-fit: contain; }
  @media (max-width: 767px) {
    .rg-dhead { justify-content: flex-start; }
  }
</style>
