---
/**
 * Icons der Support-Seiten (Nucleo-SVGs wie auf der alten Onepage-Seite). Rein dekorativ (aria-hidden).
 */
type Name =
  | 'x-gradient' | 'x' | 'check-line' | 'c-check' | 'c-question' | 'check'
  | 'arrow-right' | 'letter' | 'chevron-down' | 'plus' | 'burger' | 'close';
interface Props { name: Name; class?: string; [key: string]: unknown; }
const { name, class: cls, ...rest } = Astro.props;
const uid = `xg-${Math.random().toString(36).slice(2, 8)}`;
---
{name === 'x-gradient' && (
  <svg class={cls} {...rest} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <defs><linearGradient id={uid} x1="24" y1="6.74" x2="24" y2="41.26" gradientUnits="userSpaceOnUse"><stop stop-color="#FF666D" /><stop offset="1" stop-color="#E0211F" /></linearGradient></defs>
    <path fill={`url(#${uid})`} d="M40.971 35.3141L29.6569 24.0001L40.971 12.6861C41.361 12.2951 41.361 11.6621 40.971 11.2721L36.728 7.02907C36.338 6.63907 35.7039 6.63907 35.3139 7.02907L24 18.3431L12.686 7.02907C12.295 6.63907 11.662 6.63907 11.272 7.02907L7.02895 11.2721C6.63895 11.6631 6.63895 12.2961 7.02895 12.6861L18.343 24.0001L7.02895 35.3141C6.63895 35.7041 6.63895 36.3381 7.02895 36.7281L11.272 40.9711C11.663 41.3611 12.295 41.3611 12.686 40.9711L24 29.6571L35.3139 40.9711C35.7039 41.3611 36.338 41.3611 36.728 40.9711L40.971 36.7281C41.361 36.3381 41.361 35.7041 40.971 35.3141Z" />
  </svg>
)}
{name === 'x' && (
  <svg class={cls} {...rest} viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M31.293,13.878l-7.293,7.293-7.293-7.293c-.391-.391-1.024-.391-1.414,0l-1.415,1.415c-.391,.391-.391,1.024,0,1.414l7.293,7.293-7.293,7.293c-.391,.391-.391,1.024,0,1.414l1.415,1.415c.391,.391,1.024,.391,1.414,0l7.293-7.293,7.293,7.293c.391,.391,1.024,.391,1.414,0l1.415-1.415c.391-.391,.391-1.024,0-1.414l-7.293-7.293,7.293-7.293c.391-.391,.391-1.024,0-1.414l-1.415-1.415c-.391-.391-1.024-.391-1.414,0Z" /></svg>
