---
/**
 * Hero mit Formular (Onepage „Security Check“, Formular-Sektion, volle Bildschirmhöhe, Hintergrund #0a0f10).
 * Links: H1 (Teil orange), optionale Subline, Einleitung, 4 Haken-Punkte · rechts: Formularkarte.
 * Oben ein 8 px Fortschrittsbalken (Onepage-Formular mit 2 Schritten → 50 %), wie live.
 * Anker: #formular (Header-Button, CTA unten, Rücksprung der API ohne JS).
 */
import { circleCheckIcon } from './icons';
import { shared, type Variant } from './content';
import SecForm from './SecForm.astro';

interface Props {
  variant: Variant;
  formId: string;
  compactForm?: boolean;
}
const { variant, formId, compactForm = false } = Astro.props;
const { h1, subline, intro } = variant;
---

<section class="shero" id="formular" aria-labelledby="sec-h1">
  <div class="shero__progress" aria-hidden="true"><span></span></div>
  <div class="shero__inner">
    <div class="shero__text">
      <h1 id="sec-h1" class="sec-h-xl shero__h1">
        {h1.before}<span class="shero__accent">{h1.highlight}</span>{h1.after}
      </h1>
      {subline && <p class="sec-h-l shero__subline">{subline}</p>}
      <p class="sec-text shero__intro"><b>{intro.bold}</b><br />{intro.text}</p>
      <ul class="shero__list">
        {
          shared.bullets.map((b, i) => (
            <li>
              <span class="shero__icon" set:html={circleCheckIcon(`shero-c${i}-`)} />
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <SecForm formId={formId} compact={compactForm} />
  </div>
</section>

<style>
  .shero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    background: #0a0f10;
    color: #fff;
    padding: 50px 24px;
  }
  .shero__progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
  }
  .shero__progress span {
    display: block;
    width: 50%;
    height: 100%;
    background: var(--color-key1);
  }
  .shero__inner {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
    padding: 21px 0;
    display: grid;
    grid-template-columns: 573fr 655fr;
    column-gap: 22px;
    align-items: center;
  }
  .shero__h1 {
    white-space: pre-line;
    margin-bottom: 15px;
  }
  .shero__accent {
    color: var(--color-key1);
  }
  .shero__subline {
    margin-bottom: 20px;
  }
  .shero__intro {
    margin-bottom: 30px;
  }
  .shero__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 17px;
  }
  .shero__list li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-text);
    font-size: 15.2px;
    line-height: 22.8px;
  }
  .shero__icon {
    flex: 0 0 auto;
    width: 16.8px;
    height: 16.8px;
    display: inline-flex;
  }
  .shero__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  @media (max-width: 991px) {
    .shero__inner {
      max-width: 798px;
      grid-template-columns: 1fr;
      row-gap: 24px;
    }
  }
  @media (max-width: 767px) {
    .shero {
      padding: 25px 24px;
    }
    .shero__h1 {
      font-size: 28.98px;
      line-height: 37.07px;
    }
  }
</style>
