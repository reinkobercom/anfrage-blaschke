---
/**
 * „Deine nächsten Schritte“: orange Linie, Label, H2 und nummerierte Timeline.
 * Wie live: Nummern-Icon bleibt beim Scrollen in Bildschirmmitte kleben (sticky 50vh),
 * der Fortschrittsbalken füllt sich bis zur Bildschirmmitte – reines CSS (fixiertes
 * Pseudo-Element, das von der Maske des Balkens beschnitten wird), kein JavaScript.
 */
import type { TimelineStep } from './content';
import { schritteHead } from './content';
import './shared.css';

interface Props {
  steps: TimelineStep[];
  label?: string;
  title?: string;
}

const { steps, label = schritteHead.label, title = schritteHead.title } = Astro.props;
const headingId = 'dk-schritte-titel';
---

<section class="dk-section dkt" style="--dk-pt:0px;--dk-pb:100px" aria-labelledby={headingId}>
  <div class="dk-wrap dk-wrap--960">
    <div class="dk-line" aria-hidden="true"></div>
    <p class="dk-pill dkt__pill">{label}</p>
    <h2 class="dk-h2 dkt__title" id={headingId}>{title}</h2>

    <div class="dkt__timeline">
      <div class="dkt__bar" aria-hidden="true"></div>
      <ol class="dkt__list">
        {
          steps.map((step, i) => (
            <li class="dkt__item">
              <div class="dkt__icon" aria-hidden="true">
                <span class="dkt__num">{i + 1}</span>
              </div>
              <p class="dk-pill dkt__pill">{step.label}</p>
              <h3 class="dk-h3 dkt__step-title">{step.title}</h3>
              <p class="dk-text dk-inline-link dkt__text" set:html={step.html} />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .dkt {
    background: #fff;
    color: var(--color-dark);
    z-index: 1;
  }
  .dkt .dk-line { margin-bottom: 43px; }
  .dkt__pill { margin-bottom: 8px; }
  .dkt__title { margin-bottom: 10px; }

  .dkt__timeline {
    --dk-icon: 56px;
    --dk-item-pl: 32px;
    position: relative;
    isolation: isolate;
    padding-left: var(--dk-icon);
  }
  /* Grauer Balken (10 % Textfarbe), oben/unten weich ausgeblendet */
  .dkt__bar {
    position: absolute;
    z-index: 0;
    top: 16px;
    bottom: 16px;
    left: calc(var(--dk-icon) / 2 - 1px);
    width: 2px;
    background: rgba(10, 15, 16, 0.1);
    -webkit-mask-image: linear-gradient(0deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(0deg, transparent, #000 10%, #000 90%, transparent);
  }
  /* Orange Füllung: fixiert von Viewport-Oberkante bis zur Mitte, sichtbar nur innerhalb des Balkens */
  .dkt__bar::before {
    content: '';
    position: fixed;
    top: 0;
    width: 2px;
    height: 50vh;
    background: var(--color-key1);
  }

  .dkt__list {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dkt__item {
    position: relative;
    padding: 16px 0 16px var(--dk-item-pl);
  }
  .dkt__icon {
    position: absolute;
    top: 16px;
    left: calc(var(--dk-icon) * -1);
    width: var(--dk-icon);
    height: calc(100% - var(--dk-item-pl) * 2);
    display: flex;
    justify-content: center;
  }
  .dkt__num {
    position: sticky;
    top: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--dk-icon);
    height: var(--dk-icon);
    background: var(--color-key1);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: calc(var(--dk-icon) * 0.4);
    line-height: 1;
  }
  .dkt__step-title { margin-bottom: 10px; color: var(--color-dark); }
  .dkt__text { margin-bottom: 20px; }

  @media (max-width: 768px) {
    .dkt__timeline {
      --dk-icon: 40px;
      --dk-item-pl: 12px;
    }
  }
</style>
