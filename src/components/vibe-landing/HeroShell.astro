---
/**
 * Hero der React-Landingpages (Logo-Kopfzeile, Textspalte, Ansprechpartner, Formular-Card, Trustindex-Badge).
 * Nur die Card ist interaktiv (React-Insel, client:load) – der Rest ist statisches HTML.
 * Lade-Einblendung wie live (framer-motion initial → animate) per CSS-Animation.
 */
import { Image } from 'astro:assets';
import Title from '../siteui/title';
import Text from '../siteui/text';
import Person from './Person';
import Trustindex from '../Trustindex.astro';
import KanzleiQuiz from './KanzleiQuiz';
import NotfallplanOptin from './NotfallplanOptin';
import { imageMeta, images } from '../../data/images';
import { resolveImage } from '../../lib/resolve-image';
import vl from './vl.module.css';
import kanzleiStyles from './hero-kanzlei.module.css';
import handwerkStyles from './hero-handwerk.module.css';

interface Props {
  variant: 'kanzlei' | 'handwerk';
  /** Inhalte aus content/<seite>.ts (hero) */
  content: Record<string, any>;
  /** Trustindex-Badge unter der Card anzeigen */
  showBadge?: boolean;
}

const { variant, content: c, showBadge = true } = Astro.props;
const s = variant === 'kanzlei' ? kanzleiStyles : handwerkStyles;
const sectionId = variant === 'kanzlei' ? 'check' : 'optin';
const lukas = await resolveImage('lukas-blaschke', { widths: [120, 180] });
const cover =
  variant === 'handwerk'
    ? await resolveImage('notfallplan-handwerk-cover', { widths: [156, 234], sizes: '78px', alt: c.coverCaption })
    : null;
const bullets: { text: string }[] = Array.isArray(c.bullets) ? c.bullets : [];
---

<section id={sectionId} class={s.section} style={`background-color:${c.bgColor}`}>
  <div class={s.inner}>
    <div class={s.topbar}>
      <Image
        class={s.logoImg}
        src={imageMeta('logo-blaschke-it')}
        widths={[150, 300, 450]}
        sizes="147px"
        alt={c.logoAlt || images['logo-blaschke-it'].alt}
        loading="eager"
        fetchpriority="high"
        style="height:32px"
      />
    </div>

    <div class={s.grid}>
      <div class:list={[s.leftTop, vl.fadeUp]}>
        <div class={s.kicker}>
          <span class={s.kickerRule}></span>
          <Text kicker tone="accent" as="span">{c.kicker}</Text>
        </div>

        <Title as="h1" size="xl" className={s.headline}>
          {c.headStart}{' '}<em>{c.headAccent}</em>{' '}{c.headEnd}
        </Title>

        <Text size="lg" tone="muted" className={s.subline}>{c.subline}</Text>

        {
          bullets.length > 0 && (
            <ul class={s.bulletList}>
              {bullets.map((b, i) => (
                <li class={s.bulletItem}>
                  <span class={s.bulletNum}>{String(i + 1).padStart(2, '0')}</span>
                  <Text size="sm" as="span">{b.text}</Text>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class:list={[s.leftBottom, vl.fadeUp]} style="--fade-delay:.08s">
        {
          c.personName && (
            <div class={s.personBlock}>
              <Person photo={lukas} name={c.personName} role={c.personRole} theme="light" size="md" avatarSize={60} />
            </div>
          )
        }
      </div>

      <div class:list={[s.right, vl.fadeUp]} style="--fade-y:26px;--fade-duration:.55s;--fade-delay:.1s">
        {variant === 'kanzlei' ? <KanzleiQuiz client:load content={c} /> : <NotfallplanOptin client:load content={c} cover={cover} />}
        {
          showBadge && (
            <div class={s.trustBadge}>
              <Trustindex widget="badge" center />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
